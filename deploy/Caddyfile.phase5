{
	admin off
	servers {
		timeouts {
			read_body 10s
			read_header 5s
			write 30s
			idle 60s
		}
		max_header_size 32KB
	}
}

memory.example.com {
	encode zstd gzip
	tls {
		protocols tls1.2 tls1.3
	}

	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "no-referrer"
		-Server
	}

	request_body {
		max_size 1MB
	}

	reverse_proxy 127.0.0.1:8787 {
		health_uri /live
		health_interval 10s
		health_timeout 2s
		transport http {
			versions 1.1
			dial_timeout 2s
			response_header_timeout 10s
		}
	}

	log {
		output stdout
		format json
	}
}
