# LaTeX build artifacts (keep main.pdf committed)
papers/arxiv-v1/*.aux
papers/arxiv-v1/*.log
papers/arxiv-v1/*.out
papers/arxiv-v1/*.blg
# Copied from papers/figures/ by papers/arxiv-v1/build.sh (arXiv flat layout)
papers/arxiv-v1/figures/01-brain-architecture.pdf
papers/arxiv-v1/figures/02-benchmark-summary.pdf
papers/arxiv-v1/figures/03-longmemeval-by-type.pdf
papers/arxiv-v1/figures/04-longmemeval-e2e-by-type.pdf

# Benchmark run scratch (canonical freezes stay tracked; see benchmarks/results/.gitignore)
**/benchmarks/results/*.checkpoint.jsonl
**/benchmarks/results/*.checkpoint.jsonl.bak
**/benchmarks/results/*.log
**/benchmarks/results/.*.lock

# FluctlightDB embedded brains (local agent memory; optional commit for team sync)
.fluctlight/project/
.fluctlight/agents/
.fluctlight/**/.brain.lock
.fluctlight/.handoffs.lock
